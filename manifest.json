{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.2",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*",
        "https://kick.com/*",
        "https://www.kick.com/*",
        "https://instagram.com/*",
        "https://www.instagram.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/ambient-core.js",
        "src/card-layout.js",
        "src/streaming.js",
        "src/instagram.js",
        "src/x-posts.js",
        "src/youtube.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://www.youtube.com/embed/*"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "src/settings.js",
        "src/ambient-core.js",
        "src/streaming.js",
        "src/youtube.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "default_locale": "en"
}
